{
  "name": "rolador",
  "private": true,
  "version": "2.0.0",
  "description": "Rolador de dados para RPG de mesa: notação completa, vantagem, explosão, Fate e histórico.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
